---
import Layout from '../layouts/Layout.astro';
import { u } from '../lib/url.mjs';
---
<Layout title="페이지를 찾을 수 없습니다">
  <div class="wrap" style="padding-block:96px;display:flex;flex-direction:column;gap:16px;max-width:640px">
    <h1 style="font-size:34px;line-height:44px">페이지를 찾을 수 없습니다</h1>
    <p class="muted">주소가 바뀌었거나 없는 페이지입니다. 아래에서 다시 찾아 주세요.</p>
    <div class="row">
      <a class="su-btn su-btn-primary" href={u('products/')}>제품 보기</a>
      <a class="su-btn su-btn-secondary" href={u('quote/')}>견적문의</a>
      <a class="su-btn su-btn-ghost" href={u('')}>홈으로</a>
    </div>
  </div>
</Layout>

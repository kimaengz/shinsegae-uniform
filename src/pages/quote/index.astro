---
import Layout from '../../layouts/Layout.astro';
import { data } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
import Phone from '../../components/Phone.astro';
const { site, categories, products } = data();
const client = {
  endpoint: site.quoteEndpoint || '',
  completeUrl: u('quote/complete/'),
  productsUrl: u('products/'),
  products: Object.fromEntries(products.map((p) => [p.code, u(`products/${p.category}/${p.slug}/`)])),
  phone: site.phone
};
---
<Layout title="견적문의" active="quote" bbar="none" description="품목, 수량, 로고 자수 정보를 남기시면 담당자가 확인 후 연락드립니다.">
  <div class="wrap" style="padding-bottom:72px">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">견적문의</span></nav>
    <div class="page-h row" style="align-items:baseline;gap:12px">
      <h1 data-q-title>견적함</h1>
      <span class="muted" data-q-sub></span>
    </div>

    <div class="qw">
      <div style="display:flex;flex-direction:column;gap:40px;min-width:0">
        <div data-q-lines></div>

        <div class="empty" data-q-empty hidden>
          <p><b>담은 제품이 없습니다.</b> <a href={u('products/')}>제품을 둘러보고 담거나</a>, 아래 일반 문의로 바로 보내 주세요.</p>
        </div>


        <form class="form" novalidate data-q-form aria-labelledby="org-title">
          <h2 id="org-title" class="full">기관 정보</h2>
          <div class="alert full" role="alert" hidden data-q-alert></div>
          <fieldset class="full" data-general hidden style="border:0;margin:0;padding:0">
            <legend class="su-label" style="margin-bottom:8px">관심 카테고리</legend>
            <div class="chips">{categories.map((c) => <label class="su-chip"><input type="checkbox" name="interest" value={c.name} /><span>{c.name}</span></label>)}</div>
          </fieldset>
          <div class="su-field" data-general hidden>
            <label class="su-label" for="f-qty">예상 수량 (벌)</label>
            <input class="su-input" id="f-qty" name="qty" inputmode="numeric" placeholder="예: 120" />
          </div>
          <div class="su-field"><label class="su-label" for="f-org">병원·기관명<span class="su-req" aria-hidden="true"> *</span></label><input class="su-input" id="f-org" name="org" required autocomplete="organization" placeholder="예: OO대학교병원" /></div>
          <div class="su-field"><label class="su-label" for="f-name">담당자<span class="su-req" aria-hidden="true"> *</span></label><input class="su-input" id="f-name" name="name" required autocomplete="name" placeholder="성함 · 부서" /></div>
          <div class="su-field"><label class="su-label" for="f-tel">연락처<span class="su-req" aria-hidden="true"> *</span></label><input class="su-input" id="f-tel" name="tel" type="tel" required autocomplete="tel" placeholder="010-0000-0000" /></div>
          <div class="su-field"><label class="su-label" for="f-mail">이메일</label><input class="su-input" id="f-mail" name="email" type="email" autocomplete="email" placeholder="name@hospital.or.kr" aria-describedby="f-mail-hint" /><span class="su-hint" id="f-mail-hint">{site.quoteEndpoint ? '남기시면 접수 확인 메일을 보내 드립니다.' : '견적서를 메일로 받으시려면 적어 주세요.'}</span></div>
          <div class="su-field"><label class="su-label" for="f-due">희망 납기</label><input class="su-input" id="f-due" name="due" type="date" /></div>
          <div class="su-field">
            <span class="su-label" id="files-label">파일 첨부</span>
            <div class="file-list">
              {[['f-logo', 'logo', '로고', '.pdf,.ai,.eps,.svg,.png,.jpg,.jpeg'], ['f-doc', 'doc', '작업지시서', '.pdf,.xlsx,.xls,.png,.jpg,.jpeg,.hwp,.docx']].map(([id, name, label, accept]) => (
                <div class="file-pick" data-file-pick>
                  <span class="file-pick-name" data-file-name><b>{label}</b>선택한 파일 없음</span>
                  <label class="file-pick-btn" for={id}>파일 올리기<input id={id} name={name} type="file" accept={accept} /></label>
                </div>
              ))}
            </div>
            <span class="su-hint">각 10MB 이하</span>
          </div>
          <div class="su-field full"><label class="su-label" for="f-msg">요청사항</label><textarea class="su-input" id="f-msg" name="message" rows="4" placeholder="다른 색상(병원 로고 색 등), 배색, 납기 등 요청사항을 적어 주세요"></textarea></div>
          <div class="full" style="display:flex;flex-direction:column;gap:6px">
            <div class="row"><label class="su-chip"><input type="checkbox" id="f-agree" name="agree" required /><span>개인정보 수집·이용에 동의합니다 (필수)</span></label><a href={u('privacy/')} style="font-size:14px">내용 보기</a></div>
            <span class="su-error" id="f-agree-err" hidden></span>
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
        </form>
      </div>

      <aside class="panel" aria-label="견적 요약">
        <h2 style="font-size:18px">견적 요약</h2>
        <div class="sum" style="font-size:14px"><span class="muted">제품</span><span class="num" data-s-count>0개</span></div>
        <div class="sum" style="font-size:14px"><span class="muted">총 수량</span><span class="num" data-s-qty>0벌</span></div>
        <div style="display:flex;flex-direction:column;gap:4px;padding-top:16px;border-top:1px dashed var(--line-strong)">
          <span class="muted" style="font-size:14px">예상 금액 (참고)</span>
          <strong class="num" style="font-size:28px;line-height:34px" data-s-est>0원</strong>
          <span class="su-hint" data-s-note>확정 금액은 상담 후 견적서로 안내합니다.</span>
        </div>
        <button type="button" class="su-btn su-btn-primary su-btn-full" data-submit>견적 요청 보내기</button>
        <a href={u('products/')} style="text-align:center;font-size:14px;font-weight:600">제품 더 담기</a>
        <p class="su-caption">급한 문의 <Phone /></p>
      </aside>
    </div>
  </div>

  <script is:inline type="application/json" id="q-data" set:html={JSON.stringify(client)} />
  <script>
    import { getCart, saveCart, lineTotal, toast, embText, embUnit } from '../../scripts/cart.js';
    const Q = JSON.parse(document.getElementById('q-data')!.textContent!);
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const $$ = (s: string) => Array.from(document.querySelectorAll(s)) as HTMLElement[];
    const won = (n: number) => n.toLocaleString('ko-KR') + '원';
    const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    // 수량 구간 단가 + 자수 추가금(담을 때의 자수 단가 기준)
    const tierPrice = (l: any, n: number) => l.isPublic ? (l.prices[n >= 100 ? 2 : n >= 50 ? 1 : 0] + embUnit(l.emb, l.embPrice)) * n : null;
    let cart = getCart();

    function renderLines() {
      const box = $('[data-q-lines]');
      const empty = cart.length === 0;
      $('[data-q-empty]').hidden = !empty;
      $$('[data-general]').forEach((el) => (el.hidden = !empty));
      $('[data-q-title]').textContent = empty ? '견적문의' : '견적함';
      $('[data-q-sub]').textContent = empty ? '' : `${cart.length}개 제품 · ${cart.reduce((a, l) => a + lineTotal(l), 0)}벌`;
      box.className = empty ? '' : 'lines';
      box.innerHTML = cart.map((l, i) => `
        <article class="line" data-line="${i}">
          <span class="ph ph-23">${l.thumb ? `<img src="${esc(l.thumb)}" alt="">` : `<span class="su-card-garment" style="--sw:${esc(l.hex)}" aria-hidden="true"></span>`}</span>
          <div style="min-width:0">
            <div class="line-h">
              <div style="display:flex;flex-direction:column;gap:2px">
                <b style="font-size:18px">${esc(l.name)}</b>
                <span style="font-size:14px">${esc(l.colorName)} · <a href="${esc(Q.products[l.code] ?? Q.productsUrl)}?color=${esc(l.color)}">색상 바꾸기</a></span>
              </div>
              <button type="button" class="su-btn su-btn-ghost su-btn-sm" data-del="${i}" aria-label="${esc(l.name)} ${esc(l.colorName)} 삭제">삭제</button>
            </div>
            <div class="cq">${l.sizes.map((s: string) => `<label>${esc(s)}<input type="number" inputmode="numeric" min="0" max="9999" value="${Number(l.qty[s]) || 0}" data-size="${esc(s)}" aria-label="${esc(l.name)} ${esc(s)} 수량"></label>`).join('')}</div>
            <div class="line-f">
              <span>자수 <span class="muted">${esc(embText(l.emb))}${l.isPublic && embUnit(l.emb, l.embPrice) ? ` · 1벌당 +${won(embUnit(l.emb, l.embPrice))}` : ''}</span></span>
              <span class="num"><span data-l-qty>${lineTotal(l)}</span>벌 · <b data-l-est>${l.isPublic ? won(tierPrice(l, lineTotal(l))!) : '견적 후 안내'}</b></span>
            </div>
          </div>
        </article>`).join('');
      renderSummary();
    }
    function renderSummary() {
      const qty = cart.reduce((a, l) => a + lineTotal(l), 0);
      const est = cart.reduce((a, l) => a + (tierPrice(l, lineTotal(l)) ?? 0), 0);
      $('[data-s-count]').textContent = `${cart.length}개`;
      $('[data-s-qty]').textContent = `${qty}벌`;
      $('[data-s-est]').textContent = won(est);
      $('[data-s-note]').textContent = cart.some((l) => !l.isPublic) ? '단가 비공개 제품은 예상 금액에서 빠졌습니다. 확정 금액은 상담 후 안내합니다.' : '확정 금액은 상담 후 견적서로 안내합니다.';
    }

    const lines = $('[data-q-lines]');
    lines.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.dataset.size) return;
      const art = t.closest('[data-line]') as HTMLElement, i = Number(art.dataset.line);
      cart[i].qty[t.dataset.size] = Math.max(0, Math.min(9999, parseInt(t.value, 10) || 0));
      saveCart(cart);
      const n = lineTotal(cart[i]);
      art.querySelector('[data-l-qty]')!.textContent = String(n);
      art.querySelector('[data-l-est]')!.textContent = cart[i].isPublic ? won(tierPrice(cart[i], n)!) : '견적 후 안내';
      $('[data-q-sub]').textContent = `${cart.length}개 제품 · ${cart.reduce((a, l) => a + lineTotal(l), 0)}벌`;
      renderSummary();
    });
    lines.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-del]') as HTMLElement | null;
      if (!b) return;
      const i = Number(b.dataset.del), removed = cart.splice(i, 1)[0];
      saveCart(cart); renderLines();
      toast(`${removed.name}을(를) 뺐습니다`, { label: '되돌리기', onClick: () => { cart.splice(i, 0, removed); saveCart(cart); renderLines(); } });
    });


    // 검증
    const form = $('[data-q-form]') as HTMLFormElement;
    const setErr = (id: string, msg: string) => {
      const input = document.getElementById(id) as HTMLInputElement;
      const field = input.closest('.su-field');
      let el = document.getElementById(id + '-err');
      if (id === 'f-agree') { el!.textContent = msg; el!.hidden = !msg; input.setAttribute('aria-describedby', msg ? id + '-err' : ''); return; }
      field?.classList.toggle('is-error', !!msg);
      if (msg && !el) { el = document.createElement('span'); el.id = id + '-err'; el.className = 'su-error'; field?.append(el); }
      if (el) { el.textContent = msg; el.hidden = !msg; }
      if (msg) { input.setAttribute('aria-invalid', 'true'); input.setAttribute('aria-describedby', id + '-err'); } else input.removeAttribute('aria-invalid');
    };
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    function validate() {
      const errs: [string, string][] = [];
      if (!val('f-org')) errs.push(['f-org', '병원·기관명을 입력해 주세요.']);
      if (!val('f-name')) errs.push(['f-name', '담당자 성함을 입력해 주세요.']);
      const tel = val('f-tel');
      if (!tel) errs.push(['f-tel', '연락처를 입력해 주세요.']);
      else if (!/^[0-9-]{9,14}$/.test(tel)) errs.push(['f-tel', '숫자와 -만 입력해 주세요. 예: 010-1234-5678']);
      const mail = val('f-mail');
      if (mail && !/^\S+@\S+\.\S+$/.test(mail)) errs.push(['f-mail', '이메일 형식을 확인해 주세요. 예: name@hospital.or.kr']);
      for (const id of ['f-logo', 'f-doc']) {
        const f = (document.getElementById(id) as HTMLInputElement).files?.[0];
        if (f && f.size > 10 * 1024 * 1024) errs.push([id, '10MB 이하 파일만 보낼 수 있습니다.']);
      }
      if (!(document.getElementById('f-agree') as HTMLInputElement).checked) errs.push(['f-agree', '개인정보 수집·이용에 동의해야 보낼 수 있습니다.']);
      ['f-org', 'f-name', 'f-tel', 'f-mail', 'f-logo', 'f-doc', 'f-agree'].forEach((id) => setErr(id, errs.find((e) => e[0] === id)?.[1] ?? ''));
      return errs;
    }
    // 파일 첨부: 고른 파일 이름을 칸에 보여 준다
    document.querySelectorAll<HTMLElement>('[data-file-pick]').forEach((box) => {
      const input = box.querySelector('input[type="file"]') as HTMLInputElement;
      const name = box.querySelector('[data-file-name]')!;
      const label = name.querySelector('b')!.textContent;
      input.addEventListener('change', () => {
        const f = input.files?.[0];
        box.classList.toggle('has-file', !!f);
        name.innerHTML = '';
        const b = document.createElement('b'); b.textContent = label;
        name.append(b, f ? `${f.name} (${(f.size / 1024 / 1024).toFixed(1)}MB)` : '선택한 파일 없음');
        (box.querySelector('.file-pick-btn')!.firstChild as Text).textContent = f ? '바꾸기' : '파일 올리기';
      });
    });
    const readFile = (input: HTMLInputElement) => new Promise<any>((resolve, reject) => {
      const f = input.files?.[0];
      if (!f) return resolve(null);
      const r = new FileReader();
      r.onload = () => resolve({ name: f.name, type: f.type || 'application/octet-stream', data: String(r.result).split(',')[1] });
      r.onerror = () => reject(r.error);
      r.readAsDataURL(f);
    });

    const submit = $('[data-submit]') as HTMLButtonElement, alertBox = $('[data-q-alert]');
    submit.addEventListener('click', async () => {
      alertBox.hidden = true;
      const errs = validate();
      if (errs.length) { const first = document.getElementById(errs[0][0])!; first.focus(); first.scrollIntoView({ block: 'center' }); return; }
      if ((form.elements.namedItem('website') as HTMLInputElement).value) return; // 스팸 함정
      submit.disabled = true; submit.textContent = '보내는 중…';
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const id = `Q-${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
      const payload = {
        id, sentAt: now.toISOString(), org: val('f-org'), name: val('f-name'), tel: val('f-tel'), email: val('f-mail'),
        due: val('f-due'), message: val('f-msg'),
        interest: $$('[name="interest"]').filter((i) => (i as HTMLInputElement).checked).map((i) => (i as HTMLInputElement).value), expectedQty: val('f-qty'),
        items: cart.map((l) => ({ code: l.code, name: l.name, color: l.colorName, qty: Object.fromEntries(Object.entries(l.qty).filter(([, n]) => Number(n) > 0)), total: lineTotal(l), embroidery: embText(l.emb), estimate: tierPrice(l, lineTotal(l)) })),
        logo: null as any, doc: null as any
      };
      let sent = false;
      try {
        payload.logo = await readFile(document.getElementById('f-logo') as HTMLInputElement);
        payload.doc = await readFile(document.getElementById('f-doc') as HTMLInputElement);
        if (Q.endpoint) {
          await fetch(Q.endpoint, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
          sent = true;
        }
      } catch {
        submit.disabled = false; submit.textContent = '견적 요청 보내기';
        alertBox.textContent = `견적을 보내지 못했습니다. 입력한 내용은 그대로 있습니다. 다시 시도하거나 ${Q.phone}로 전화해 주세요.`;
        alertBox.hidden = false; alertBox.scrollIntoView({ block: 'center' });
        return;
      }
      try {
        sessionStorage.setItem('su-last-quote', JSON.stringify({ id, org: payload.org, email: payload.email, items: payload.items, sent }));
      } catch { /* 완료 화면 요약만 생략 */ }
      cart = []; saveCart(cart);
      location.href = Q.completeUrl;
    });

    renderLines();
  </script>
</Layout>

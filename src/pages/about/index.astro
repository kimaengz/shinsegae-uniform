---
import Layout from '../../layouts/Layout.astro';
import Garment from '../../components/Garment.astro';
import { data, siteImage } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
import Phone from '../../components/Phone.astro';
const { site } = data();
const process = ['재단', '봉제', '자수', '검수'].map((t, i) => [t, siteImage(`about/process-${i + 1}`)]);
const certs = [['여성기업 확인', '2019.11'], ['직접생산확인 (의류 제조)', '2019.11'], ['조달청 나라장터 경쟁입찰참가 자격', '2019.11']].map(([t, d], i) => [t, d, siteImage(`about/cert-${i + 1}`)]);
// 기업소개서 '핵심 경쟁력'
const strengths = [
  ['직접 제조', '기획부터 디자인, 제작, 본 생산, 검수까지 전 과정을 직접 합니다. 유통 단계를 줄여 합리적인 단가와 균일한 품질을 지킵니다.'],
  ['현장 맞춤 소재와 패턴', '사방 스트레치, 구김 방지, 통기성 원단과 인체공학적 입체 패턴으로 오래 일해도 편하고 단정합니다.'],
  ['공공 조달 협력', '여성기업 인증과 조달청 나라장터 경쟁입찰참가 자격을 갖춰, 국공립 병원과 공공기관의 기준에 맞춰 납품합니다.'],
  ['빠른 사후 대응', '추가 보완 요청에 빠르게 대응하고, 현장 실무자와 의료진의 피드백을 다음 제작에 반영합니다.']
];
const history = [
  ['2015.07', '신세계유니폼 설립'],
  ['2017.09', '모범납세자 · 성실사업자 선정'],
  ['2019.11', '직접생산확인(의류 제조) · 여성기업 확인 · 조달청 나라장터 경쟁입찰참가 자격 등록'],
  ['2021.04', '국공립 의료기관 및 공공 · 보건기관 직접 제조 · 납품 계약']
];
---
<Layout title="회사소개" active="about" description="2015년 설립, 대구의 메디컬 유니폼 전문 제조사. 기획부터 생산, 검수, 납품까지 직접 합니다.">
  <div class="wrap">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">회사소개</span></nav>
    <div class="page-h"><h1>회사소개</h1><p>{site.founded}년 대구에서 시작한 메디컬 유니폼 전문 제조사입니다.</p></div>
    <section class="about-intro">
      <p class="about-statement">의료 현장을 위한 유니폼을<br />기획부터 납품까지 직접 만듭니다.</p>
      <div class="about-body">
        <p class="muted">{site.founded}년 설립 이후 메디컬 유니폼 한 길만 걸어왔습니다. 의료진의 유니폼은 전문성과 병원의 가치를 보여 주는 얼굴이라는 생각으로, 검증된 고기능성 원단과 현장의 목소리를 반영한 인체공학적 패턴으로 직접 기획하고 만듭니다.</p>
        <p class="about-sign">대표 <b>{site.ceo}</b></p>
      </div>
      <div class="about-photo"><Garment hex="#F2F2EE" src={siteImage('about/brand')} ratio="43" /></div>
    </section>
  </div>
  <div class="wrap about-secs">
    <section class="split">
      <h2>핵심 경쟁력</h2>
      <ol class="strengths">{strengths.map(([t, d], i) => <li><span class="idx num">{String(i + 1).padStart(2, '0')}</span><b>{t}</b><p class="muted">{d}</p></li>)}</ol>
    </section>
    <section class="split">
      <div><h2>직접 제조 공정</h2><p class="muted split-desc">외주 없이 자체 공장에서 만들고 검수합니다.</p></div>
      <ol class="process">{process.map(([t, src], i) => <li><span class="ph" style="aspect-ratio:3/2"><img src={u(src)} alt={`${t} 공정`} loading="lazy" /></span><span class="process-t"><span class="idx num">{String(i + 1).padStart(2, '0')}</span><b>{t}</b></span></li>)}</ol>
    </section>
    <section class="split">
      <h2>연혁</h2>
      <ol class="history">{history.map(([d, t]) => <li><span class="num">{d}</span><span>{t}</span></li>)}</ol>
    </section>
    <section class="split">
      <h2>인증</h2>
      <ul class="certs">{certs.map(([t, d, src]) => <li><span class="ph" style="aspect-ratio:3/4"><img src={u(src)} alt={`${t} 인증서`} loading="lazy" /></span><b>{t}</b><span class="muted num">{d} 취득</span></li>)}</ul>
    </section>
    <section class="split">
      <h2>오시는 길</h2>
      <dl class="visit">
        <div><dt>주소</dt><dd>{site.address}</dd></div>
        <div><dt>전화</dt><dd><Phone /></dd></div>
      </dl>
    </section>
  </div>
</Layout>

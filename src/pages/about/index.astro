---
import Layout from '../../layouts/Layout.astro';
import Garment from '../../components/Garment.astro';
import { data, siteImage } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
import Phone from '../../components/Phone.astro';
const { site, references } = data();
const process = ['재단', '봉제', '자수', '검수'].map((t, i) => [t, siteImage(`about/process-${i + 1}`)]);
// 인증서 사진: public/images/about/cert-1~3 (사업자번호 · QR은 가린 사본)
const certs = [['여성기업 확인', '유효기간 2025.11 ~ 2028.11'], ['직접생산확인 (유니폼)', '2026.11 확인'], ['조달청 나라장터 경쟁입찰참가자격', '2019.11 등록 · 2026.11 갱신']].map(([t, d], i) => [t, d, siteImage(`about/cert-${i + 1}`)]);
// 기업소개서 '핵심 경쟁력'
const strengths = [
  ['직접 제조', '기획부터 디자인, 제작, 본 생산, 검수까지 전 과정을 직접 합니다. 유통 단계를 줄여 합리적인 단가를 지키고, 직접 고른 고기능성 원단과 품질 관리로 균일한 제품을 만듭니다.'],
  ['현장 맞춤 소재와 패턴', '사방 스트레치, 구김 방지, 통기성 원단과 인체공학적 입체 패턴으로 오래 일해도 편하고 단정합니다.'],
  ['공공 조달 협력', '여성기업 인증과 조달청 나라장터 경쟁입찰참가 자격을 갖춰, 국공립 병원과 공공기관의 기준에 맞춰 납품합니다.'],
  ['철저한 사후 관리', '추가 보완 요청에 빠르고 체계적으로 대응하고, 현장 실무자와 의료진의 피드백을 다음 제작에 반영합니다.']
];
// 회사소개서(2026.11 받은 회사연혁 PDF) '연혁' 그대로
const history = [
  ['2015.07.20', '신세계유니폼 설립'],
  ['2017.09.21', '모범납세자 및 성실사업자 선정 (투명한 경영과 성실한 납세 의무 이행)'],
  ['2019.11.14', '중소벤처기업부 직접생산확인증명서 획득 (의류 제조 부문)'],
  ['2019.11.14', '여성기업 확인서 취득'],
  ['2019.11.14', '조달청 나라장터(G2B) 경쟁입찰참가 자격 등록'],
  ['2021.04.29', '국공립 의료기관 및 주요 공공 · 보건기관 대상 직접 제조 · 납품 계약 체결']
];
// 회사소개서 '기업개요'
const overview = [
  ['회사명', `${site.companyName} (메디컬 유니폼 전문 기업)`],
  ['대표자', site.ceo],
  ['설립일', '2015년 7월 20일'],
  ['주요사업', '대학병원, 종합병원, 전문 클리닉 등 맞춤형 메디컬 유니폼 기획 · 제작 · 납품'],
  ['주소', site.address]
];
---
<Layout title="회사소개" active="about" description="2015년 설립한 대구의 메디컬 유니폼 전문 제조사. 대학병원, 종합병원, 전문 클리닉의 유니폼을 기획부터 제작, 납품까지 직접 합니다.">
  <div class="wrap">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">회사소개</span></nav>
    <div class="page-h"><h1>회사소개</h1><p>{site.founded}년 대구에서 시작한 메디컬 유니폼 전문 제조사입니다.</p></div>
    <section class="about-intro">
      <p class="about-statement">의료 현장을 위한 유니폼을<br />기획부터 납품까지 직접 만듭니다.</p>
      <div class="about-body">
        <div class="about-greeting">
          <p>신세계유니폼은 메디컬 유니폼 한 길만 걸어오며 의료 현장과 보건 · 복지기관의 신뢰를 쌓아 온 전문 제조 기업입니다.</p>
          <p>병원은 생명을 다루는 엄숙한 공간이자, 환자가 가장 먼저 마주하는 병원의 철학이 담긴 곳입니다. 하루 종일 환자를 돌보는 의료진의 유니폼은 단순한 옷이 아니라 의료진의 전문성과 병원의 가치를 대변하는 얼굴입니다. 그래서 검증된 고기능성 원단을 고르고, 현장의 목소리를 반영한 인체공학적 패턴으로 유니폼을 직접 기획하고 만들어 왔습니다.</p>
          <p>앞으로도 지역을 대표하는 여성기업으로서 현장의 목소리에 귀 기울이며, 대한민국 헬스케어와 보건의료의 품격을 높이는 든든한 동반자가 되겠습니다.</p>
        </div>
        <p class="about-sign">대표 <b>{site.ceo}</b></p>
      </div>
      <div class="about-photo"><Garment hex="#F2F2EE" src={siteImage('about/brand')} ratio="43" /></div>
    </section>
  </div>
  <div class="wrap about-secs">
    <section class="split">
      <h2>핵심 경쟁력</h2>
      <ol class="strengths">{strengths.map(([t, d], i) => <li><span class="idx num">{String(i + 1).padStart(2, '0')}</span><b>{t}</b><p class="muted">{d}</p></li>)}</ol>
    </section>
    <section class="split">
      <div><h2>직접 제조 공정</h2><p class="muted split-desc">외주 없이 자체 공장에서 만들고 검수합니다.</p></div>
      <ol class="process">{process.map(([t, src], i) => <li><span class="ph" style="aspect-ratio:3/2"><img src={u(src)} alt={`${t} 공정`} loading="lazy" /></span><span class="process-t"><span class="idx num">{String(i + 1).padStart(2, '0')}</span><b>{t}</b></span></li>)}</ol>
    </section>
    <section class="split">
      <h2>연혁</h2>
      <ol class="history">{history.map(([d, t]) => <li><span class="num">{d}</span><span>{t}</span></li>)}</ol>
    </section>
    <section class="split">
      <h2>인증</h2>
      <ul class="certs">{certs.map(([t, d, src]) => <li><span class="ph" style="aspect-ratio:3/4"><img src={u(src)} alt={`${t} 인증서`} loading="lazy" /></span><b>{t}</b><span class="muted num">{d}</span></li>)}</ul>
    </section>
    {references.length > 0 && (
      <section class="split" id="clients">
        <div><h2>Clients</h2><p class="muted split-desc">유니폼을 만들어 납품한 병원과 기관입니다.</p></div>
        <ul class="clients">{references.map((r) => <li><b>{r.name}</b>{r.note && <span class="muted">{r.note}</span>}</li>)}</ul>
      </section>
    )}
    <section class="split">
      <h2>기업 개요</h2>
      <dl class="visit">
        {overview.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
        <div><dt>전화</dt><dd><Phone /></dd></div>
      </dl>
    </section>
  </div>
</Layout>

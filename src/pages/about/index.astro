---
import Layout from '../../layouts/Layout.astro';
import Garment from '../../components/Garment.astro';
import { data, siteImage } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
const { site } = data();
const process = ['재단', '봉제', '자수', '검수'].map((t, i) => [t, siteImage(`about/process-${i + 1}`)]);
const certs = ['여성기업', '직접생산확인', '나라장터 등록'].map((t, i) => [t, siteImage(`about/cert-${i + 1}`)]);
---
<Layout title="회사소개" active="about" description="2015년 설립, 대구의 메디컬 유니폼 전문 제조사. 기획부터 생산, 검수, 납품까지 직접 합니다.">
  <div class="wrap">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">회사소개</span></nav>
    <div class="page-h"><h1>회사소개</h1></div>
    <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:40px;padding-bottom:72px">
      <div style="display:flex;flex-direction:column;gap:16px">
        <h2 style="font-size:24px">의료 현장을 위한 유니폼을<br />기획부터 납품까지 직접 만듭니다</h2>
        <p class="muted" style="max-width:34em">{site.founded}년 설립 이후 메디컬 유니폼 한 분야에 집중해 왔습니다. [브랜드 소개 2~3문장: 의료진의 움직임과 근무 환경을 고려한 설계, 직접 생산으로 맞추는 단가와 품질]</p>
      </div>
      <Garment hex="#F2F2EE" src={siteImage('about/brand')} ratio="43" />
    </section>
  </div>
  <section class="sec" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-h"><div><h2 style="font-size:24px">직접 제조 공정</h2><p>외주 없이 자체 공장에서 만들고 검수합니다.</p></div></div>
      <div class="cards">{process.map(([t, src]) => <div style="display:flex;flex-direction:column;gap:10px"><span class="ph" style="aspect-ratio:3/2"><img src={u(src)} alt={`${t} 공정`} loading="lazy" /></span><b>{t}</b></div>)}</div>
    </div>
  </section>
  <section class="sec sec-tight">
    <div class="wrap">
      <div class="sec-h"><h2 style="font-size:24px">인증</h2></div>
      <div class="cards cards-3">{certs.map(([t, src]) => <div style="display:flex;flex-direction:column;gap:10px"><span class="ph" style="aspect-ratio:4/3"><img src={u(src)} alt={`${t} 인증서`} loading="lazy" /></span><b>{t}</b></div>)}</div>
    </div>
  </section>
  <section class="sec sec-tight">
    <div class="wrap">
      <div class="sec-h"><h2 style="font-size:24px">오시는 길</h2></div>
      <p>{site.address}</p>
      <p class="muted" style="margin-top:6px">T <span class="num">{site.phone}</span></p>
    </div>
  </section>
</Layout>

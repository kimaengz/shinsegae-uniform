---
import Layout from '../../layouts/Layout.astro';
import { data } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
const { site, references } = data();
const groups = [...new Set(references.map((r) => r.type))].map((t) => [t, references.filter((r) => r.type === t)]);
---
<Layout title="납품 실적" active="references" description="대학병원, 종합병원, 전문 클리닉, 공공기관에 메디컬 유니폼을 납품하고 있습니다.">
  <div class="wrap">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">납품 실적</span></nav>
    <div class="page-h"><h1>납품 실적</h1><p>대학병원부터 공공기관까지, 현장에 맞춘 유니폼을 직접 만들어 납품합니다.</p></div>
  </div>
  {site.referenceCount && (
    <section class="trust-band" style="border-top:1px dashed var(--line-strong)" aria-label="납품 지표">
      <div class="wrap trust trust-3">
        <div><span class="su-caption">납품 기관</span><strong class="num">{site.referenceCount}곳</strong></div>
        <div><span class="su-caption">공공 조달</span><strong>나라장터 등록</strong></div>
        <div><span class="su-caption">설립</span><strong class="num">{site.founded}</strong></div>
      </div>
    </section>
  )}
  <section class="sec" style={site.referenceCount ? '' : 'padding-top:0'}>
    <div class="wrap">
      {groups.length ? (
        <>
          <div class="sec-h"><h2 style="font-size:24px">유형별 납품 기관</h2></div>
          <div class="cards">
            {groups.map(([type, list]) => (
              <div><b>{type}</b><ul class="muted" style="margin:10px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:4px">{list.map((r) => <li>{r.name}</li>)}</ul></div>
            ))}
          </div>
        </>
      ) : (
        <p class="empty">납품 기관 목록을 정리하고 있습니다. 납품 이력이 궁금하시면 견적문의로 남겨 주세요.</p>
      )}
    </div>
  </section>
  <section style="padding-bottom:72px"><div class="wrap"><div class="cta"><div><h2 style="font-size:24px">우리 병원도 상담받아 보세요</h2><p>품목과 수량만 알려 주시면 담당자가 연락드립니다.</p></div><a class="su-btn su-btn-primary" href={u('quote/')}>견적문의</a></div></div></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Garment from '../components/Garment.astro';
import { data, siteImage } from '../lib/data.mjs';
import { u } from '../lib/url.mjs';
const { site, categories, products } = data();
const news = products.filter((p) => p.isNew).slice(0, 3);
const countOf = (id: string) => products.filter((p) => p.category === id).length;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: site.companyName, alternateName: 'SHINSEGAE UNIFORM',
  url: new URL(u(''), Astro.site).href, logo: new URL(u('logo.svg'), Astro.site).href, foundingDate: site.founded,
  founder: site.ceo, address: { '@type': 'PostalAddress', streetAddress: site.address, addressCountry: 'KR' },
  ...(/\d/.test(site.phone) ? { telephone: site.phone } : {})
};

---
<Layout title="홈">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(org)} />
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span>{site.founded}년부터 대구에서 직접 만듭니다</span></p>
      <h1 class="hero-title">병원 현장을 위한<br />메디컬 유니폼</h1>
      <p class="lead">스크럽부터 가운, 환자복까지. 병원 로고 자수와 색상을 맞춰 단체로 납품합니다.</p>
      <div class="row hero-actions">
        <a class="su-btn su-btn-primary" href={u('quote/')}>견적문의</a>
        <a class="link-more link-lg" href={u('products/')}>제품 둘러보기</a>
      </div>
    </div>
    <div class="hero-photo">
      <!-- 모델 착용 사진: public/images/hero.jpg|png|webp (가로형 4:3, 배경 #F8F2ED — .hero의 --hero-bg와 같게) -->
      <img src={u(siteImage('hero'))} alt="" fetchpriority="high" />
    </div>
  </section>

  <section class="trust-band" aria-label="회사 신뢰 정보">
    <div class={`wrap trust${site.referenceCount ? '' : ' trust-3'}`}>
      <div><span class="su-caption">설립</span><strong class="num">{site.founded}</strong><span class="trust-sub">메디컬 유니폼 한 분야</span></div>
      <div><span class="su-caption">생산</span><strong>100% 직접 제조</strong><span class="trust-sub">기획 · 디자인 · 생산 · 검수</span></div>
      <div><span class="su-caption">공공 조달</span><strong>나라장터 등록</strong><span class="trust-sub">여성기업 · 직접생산확인</span></div>
      {site.referenceCount && <div><span class="su-caption">납품</span><strong class="num">{site.referenceCount}곳</strong><a class="trust-sub" href={u('references/')}>{site.referenceHeadline ? `${site.referenceHeadline} 외 ` : ''}제작사례</a></div>}
    </div>
  </section>

  {news.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-h sec-h-ed">
          <h2>신제품</h2>
          <p>새로 디자인한 {news.length}종입니다.</p>
          <a class="link-more" href={u('new/')}>신제품 전체 보기</a>
        </div>
        <div class="cards cards-3">{news.map((p) => <ProductCard p={p} />)}</div>
      </div>
    </section>
  )}

  <section class="sec sec-tight">
    <div class="wrap">
      <div class="sec-h sec-h-ed">
        <h2>현장별 유니폼</h2>
        <p>수술실부터 외래, 상담 데스크까지 일하는 자리에 맞춰 나눴습니다.</p>
        <a class="link-more" href={u('products/')}>전체 제품 보기</a>
      </div>
      <div class="cards cards-3">
        {categories.map((c, i) => (
          <a class="cat-card" href={u(`products/${c.id}/`)}>
            <Garment hex="#F2F2EE" src={c.image} ratio="43" />
            <span class="cat-row"><span class="cat-no num">{String(i + 1).padStart(2, '0')}</span><b>{c.name}</b>{countOf(c.id) > 0 && <span class="cat-count num">{countOf(c.id)}종</span>}</span>
            <span class="muted cat-sum">{c.summary}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-sec">
    <div class="wrap">
      <div class="cta">
        <div><h2>병원 로고와 색상까지 맞춘 단체 견적</h2><p>제품을 골라 견적함에 담거나, 담은 제품 없이 일반 문의로 바로 보내실 수 있습니다.</p></div>
        <a class="su-btn su-btn-primary" href={u('quote/')}>견적문의</a>
      </div>
    </div>
  </section>
</Layout>

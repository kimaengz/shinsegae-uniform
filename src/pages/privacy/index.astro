---
import Layout from '../../layouts/Layout.astro';
import { data } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
const { site } = data();
// 시행일 · 책임자는 회사 확인 후 바꿀 수 있다 (법률 검토 전 기본안)
const sections: [string, string][] = [
  ['1. 수집 항목', '필수: 병원·기관명, 담당자 성함·부서, 연락처. 선택: 이메일, 희망 납기, 요청사항, 첨부 파일(로고).'],
  ['2. 이용 목적', '견적 산출, 상담 연락, 샘플 발송, 계약 진행에만 이용합니다.'],
  ['3. 보관 기간', '문의일로부터 3년간 보관한 뒤 지체 없이 파기합니다. 계약이 이뤄지면 관련 법령이 정한 기간 동안 보관합니다.'],
  ['4. 처리 위탁 · 국외 이전', '접수 내용은 Google LLC의 서비스(구글 시트 · 드라이브 · 메일)에 저장됩니다. 이 서비스의 서버는 미국 등 국외에 있을 수 있으며, 견적 접수 시점에 인터넷으로 전송됩니다.'],
  ['5. 파기 방법', '보관 기간이 지난 정보는 시트와 드라이브에서 삭제하고, 출력물은 분쇄합니다.'],
  ['6. 이용자의 권리', '본인의 개인정보 열람 · 정정 · 삭제 · 처리 정지를 아래 연락처로 요청하실 수 있으며, 지체 없이 처리해 드립니다.'],
  ['7. 동의 거부', `동의하지 않으실 수 있으며, 이 경우 홈페이지 견적 접수 대신 전화(${site.phone})로 상담해 드립니다.`],
];
---
<Layout title="개인정보처리방침" description="견적 문의에서 수집하는 개인정보와 보관 기간 안내입니다.">
  <div class="wrap privacy">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">개인정보처리방침</span></nav>
    <div class="page-h"><h1>개인정보처리방침</h1><p>{site.companyName}은 홈페이지 견적 문의로 받은 개인정보를 아래와 같이 처리합니다.</p></div>
    <div class="privacy-body">
      {sections.map(([h, t]) => <section><h2>{h}</h2><p>{t}</p></section>)}
      <section><h2>8. 개인정보 보호 책임자</h2><p>대표 {site.ceo} · 전화 <span class="num">{site.phone}</span>{site.email && ` · ${site.email}`}</p></section>
      <p class="muted privacy-date">시행일: 2026년 11월 25일</p>
    </div>
  </div>
</Layout>

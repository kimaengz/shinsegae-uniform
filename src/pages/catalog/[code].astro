---
// 제품 소개서 A4 한 장 (PDF로 찍는 페이지, 사이트 메뉴에는 없음)
import '../../styles/tokens.css';
import '../../styles/catalog.css';
import Logo from '../../components/Logo.astro';
import { data } from '../../lib/data.mjs';
import { u, won } from '../../lib/url.mjs';
import { isReal, qrSvg, issued, TO_JPEG } from '../../lib/catalog.mjs';

export function getStaticPaths() {
  return data().products.map((p) => ({ params: { code: p.slug }, props: { p } }));
}
interface Props { p: any }
const { p } = Astro.props;
const { site, categories } = data();
const cat = categories.find((c) => c.id === p.category);
// 사진: 썸네일(대표 사진) 풀샷 + 옆에 세로 사진 2장(다른 색 앞면 먼저, 없으면 기본 색의 다른 사진)
// 칸을 사진과 같은 2:3 세로로 잡아 얼굴이 잘리지 않게 한다. 넣을 사진이 없으면 대표 사진 한 장만.
const photo = p.thumb;
const isPh = (src: string) => !src || src.includes('placeholder');
const extras = [...new Set([
  ...p.colors.slice(1).map((c: any) => p.gallery[c.slug]?.[0]?.src),
  ...(p.gallery[p.colors[0]?.slug] ?? []).map((g: any) => g.src)
].filter((src) => !isPh(src) && src !== photo))].slice(0, 2) as string[];
const pageUrl = new URL(u(`products/${p.category}/${p.slug}/`), Astro.site).href;
const qr = await qrSvg(pageUrl);
const hasPhone = /\d/.test(site.phone);
// 왼쪽: 색상 · 사이즈 · 구성 / 오른쪽: 단가 · 자수 · 소재 · 기능 · 관리 (자리표시인 줄은 숨김)
const rowsLeft: [string, string][] = [['사이즈', p.sizeText], ['구성', p.type]].filter(([, v]) => isReal(v)) as [string, string][];
const rowsRight: [string, string][] = [
  ['자수 위치', p.embroidery.length ? `${p.embroidery.join(' · ')} (병원 로고 · 이름)` : ''],
  ['소재', p.material], ['기능', p.function], ['관리', p.care]
].filter(([, v]) => isReal(v)) as [string, string][];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>{p.name} 제품 소개서 | {site.companyName}</title>
  <link rel="stylesheet" href={u('fonts/pretendard/pretendard.css')} />
</head>
<body>
  <section class="sheet">
    <header class="sheet-hd"><Logo /><span>제품 소개서 · {issued()}</span></header>
    <div class="p-title">
      <span class="p-meta">{p.isNew && 'NEW · '}{cat.name} · {p.code}</span>
      <h1>{p.name}</h1>
      {isReal(p.summary) && <p>{p.summary}</p>}
    </div>
    <div class={`p-photos ${['one', 'two', 'three'][extras.length]}`}>
      <span class="main"><img src={u(photo)} alt="" /></span>
      {extras.length > 0 && <span class="sub">{extras.map((src) => <span><img src={u(src)} alt="" /></span>)}</span>}
    </div>
    <div class="p-info">
      <dl>
        <div><dt>색상</dt><dd>
          <span class="swatches">{p.colors.map((c: any) => <span><i style={`--sw:${c.hex}`}></i>{c.name}</span>)}</span>
          <span class="muted">병원 로고 색 등 다른 색상도 제작 가능합니다.</span>
        </dd></div>
        {rowsLeft.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <dl>
        <div><dt>단가</dt><dd>{p.isPublic
          ? (p.tiered
            ? <><span class="price">{won(p.prices[0])}부터</span><br /><span class="muted">참고 단가 · 10~49벌 {won(p.prices[0])} · 50~99벌 {won(p.prices[1])} · 100벌 이상 {won(p.prices[2])}. VAT 별도. 자수 · 옵션에 따라 견적서로 안내합니다.</span></>
            : <><span class="price">{won(p.prices[0])}</span> <span class="muted">(1벌 · VAT 별도)</span><br /><span class="muted">자수 · 옵션에 따라 견적서로 안내합니다.</span></>)
          : <><span class="price">견적 후 안내</span><br /><span class="muted">수량 · 자수 · 옵션에 맞춰 견적서로 안내합니다.</span></>}</dd></div>
        {rowsRight.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
    <footer class="sheet-ft">
      <div>
        <b>{site.companyName}</b> · 메디컬 유니폼 직접 제조<br />
        {site.address}<br />
        {hasPhone && <>T {site.phone} · </>}{new URL(u(''), Astro.site).host}{u('')}
      </div>
      <div class="qr"><span>제품 페이지 ·<br />견적문의</span><Fragment set:html={qr} /></div>
    </footer>
  </section>
  <script is:inline set:html={TO_JPEG}></script>
</body>
</html>

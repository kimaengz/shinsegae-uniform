---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { data } from '../../lib/data.mjs';
import { u } from '../../lib/url.mjs';
const news = data().products.filter((p) => p.isNew);
---
<Layout title="신제품" active="new" description="신세계유니폼이 새로 디자인한 메디컬 유니폼입니다.">
  <div class="wrap new-page">
    <nav class="crumb su-caption" aria-label="현재 위치"><a href={u('')}>홈</a><span aria-hidden="true">/</span><span aria-current="page">신제품</span></nav>
    <div class="page-h">
      <h1>신제품</h1>
      <p>{news.length ? `새로 디자인한 메디컬 유니폼 ${news.length}종입니다.` : '새로 디자인한 메디컬 유니폼을 소개합니다.'}</p>
      <a class="link-more page-h-link" href={u('products/')}>전체 제품 보기</a>
    </div>
    {news.length ? <div class="cards cards-3 cards-new">{news.map((p) => <ProductCard p={p} eager />)}</div> : <p class="empty">곧 새로운 제품을 소개합니다.</p>}
  </div>
</Layout>

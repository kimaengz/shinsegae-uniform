---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import '../styles/motion.css';
import { data, siteImage } from '../lib/data.mjs';
import { u } from '../lib/url.mjs';
import Phone from '../components/Phone.astro';
import Logo from '../components/Logo.astro';

interface Props { title: string; description?: string; active?: string; bbar?: 'default' | 'none' | 'custom' }
const { title, description = '병원·기관 단체 메디컬 유니폼. 스크럽, 간호복, 의사 가운, 환자복을 직접 제조하고 로고 자수까지 맞춰 납품합니다.', active = '', bbar = 'default' } = Astro.props;
const { site, categories } = data();
const tel = /\d/.test(site.phone) ? site.phone.replace(/[^\d+]/g, '') : '';
const fullTitle = title === '홈' ? `${site.companyName} | 병원 단체 메디컬 유니폼` : `${title} | ${site.companyName}`;
// 메뉴 순서: 제품 중심 (견적문의는 맨 끝에 따로)
const nav = [['new', '신제품'], ['products', '제품'], ['references', '납품 실적'], ['about', '회사소개']];
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:image" content={new URL(u(siteImage('og')), Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={u('fonts/pretendard/pretendard.css')} />
  <meta name="theme-color" content="#ffffff" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">본문 바로가기</a>
  <header class="hd">
    <div class="wrap hd-in">
      <a class="logo" href={u('')} aria-label={`${site.companyName} 홈`}>
        <Logo class="logo-svg" />
      </a>
      <nav class="nav" aria-label="주 메뉴">
        {nav.map(([k, label]) => k === 'products' ? (
          <span class="nav-sub">
            <a href={u('products/')} aria-current={active === k ? 'page' : undefined}>{label}</a>
            <span class="nav-sub-list">
              {categories.map((c) => <a href={u(`products/${c.id}/`)}>{c.name}</a>)}
            </span>
          </span>
        ) : (
          <a href={u(`${k}/`)} aria-current={active === k ? 'page' : undefined}>{label}</a>
        ))}
        <a class="nav-cta" href={u('quote/')} aria-current={active === 'quote' ? 'page' : undefined}>견적문의<span class="su-tag su-tag-count cart-count" data-cart-count hidden>0</span></a>
      </nav>
      <div class="m-only row" style="gap:4px">
        <a href={u('quote/')} class="row" style="gap:6px;font-size:14px;font-weight:600;color:var(--ink);text-decoration:none;height:44px">견적문의<span class="su-tag su-tag-count cart-count" data-cart-count hidden>0</span></a>
        <button type="button" class="menu-btn" aria-expanded="false" aria-controls="m-menu" aria-label="전체 메뉴 열기" data-menu-btn>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </button>
      </div>
    </div>
    <nav class="m-menu" id="m-menu" aria-label="전체 메뉴" hidden>
      <div class="wrap">
        {nav.map(([k, label]) => <a href={u(`${k}/`)}>{label}</a>)}
        <a href={u('quote/')}>견적문의</a>
        <p class="muted">대표번호 <Phone /></p>
      </div>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="ft">
    <div class="wrap ft-top"><Logo class="logo-svg logo-svg-ft" /></div>
    <div class="wrap ft-in">
      <div>
        <b>회사 정보</b>
        <span>{site.companyName} · 대표 {site.ceo}</span>
        {site.businessNumber && <span>사업자등록번호 {site.businessNumber}</span>}
        {site.address && <span>{site.address}</span>}
      </div>
      <div>
        <b>견적 상담</b>
        <span>T <Phone /></span>
        {site.email && <span>E {site.email}</span>}
      </div>
      <div>
        <b>인증</b>
        <span>여성기업 · 직접생산확인 · 나라장터 등록</span>
      </div>
    </div>
    <div class="wrap ft-bottom">
      <span>© {site.companyName}. All rights reserved.</span>
      <a href={u('privacy/')}><b>개인정보처리방침</b></a>
    </div>
  </footer>

  {bbar === 'default' && (
    <div class="bbar">
      {tel && <a class="bbar-call" href={`tel:${tel}`} aria-label={`전화 ${site.phone}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg></a>}
      <a class="su-btn su-btn-primary bbar-cta" href={u('quote/')}>견적 문의하기</a>
    </div>
  )}
  <slot name="bbar" />
  <div class="toast-host" id="toast-host" role="status" aria-live="polite"></div>

  <script>
    import { renderCount } from '../scripts/cart.js';
    import { dragScroll } from '../scripts/drag.js';
    import '../scripts/motion.js';
    renderCount();
    const btn = document.querySelector('[data-menu-btn]');
    const menu = document.getElementById('m-menu');
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? '전체 메뉴 닫기' : '전체 메뉴 열기');
      if (menu) menu.hidden = !open;
    });
    // 제품 카드: 사진을 옆으로 넘기면 아래 점이 따라가고, 색상 점을 누르면 그 색 사진들로 바꾼다
    const setPager = (track: HTMLElement) => {
      const i = Math.round(track.scrollLeft / (track.clientWidth || 1));
      track.parentElement!.querySelectorAll('[data-pager] i').forEach((d, j) => d.classList.toggle('on', j === i));
    };
    // 카드의 2번째 사진부터는 마우스를 올리거나 만지거나 넘길 때 불러온다 (처음 화면을 가볍게)
    const hydrate = (track: HTMLElement) => track.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
    document.querySelectorAll<HTMLElement>('[data-track]').forEach((t) => {
      t.addEventListener('scroll', () => { hydrate(t); setPager(t); }, { passive: true });
      ['pointerenter', 'touchstart', 'focusin'].forEach((ev) => t.addEventListener(ev, () => hydrate(t), { once: true, passive: true }));
      dragScroll(t);
    });
    document.addEventListener('click', (e) => {
      const dot = (e.target as HTMLElement).closest('.su-card .su-dot') as HTMLElement | null;
      if (!dot) return;
      const card = dot.closest('[data-card]')!;
      card.querySelectorAll('.su-dot').forEach((d) => d.setAttribute('aria-pressed', String(d === dot)));
      const name = card.querySelector('[data-card-color]');
      if (name) name.textContent = dot.dataset.name ?? '';
      const srcs: string[] = JSON.parse(dot.dataset.srcs || '[]');
      const track = card.querySelector<HTMLElement>('[data-track]');
      const pager = card.querySelector<HTMLElement>('[data-pager]');
      if (!track || !srcs.length) return;
      track.innerHTML = srcs.map((s) => `<span class="card-slide"><img src="${s}" alt="" draggable="false"></span>`).join('');
      hydrate(track);
      track.scrollLeft = 0;
      if (pager) { pager.innerHTML = srcs.map((_, i) => `<i class="${i ? '' : 'on'}"></i>`).join(''); pager.hidden = srcs.length < 2; }
    });
  </script>
</body>
</html>

---
import Garment from './Garment.astro';
import { u, won } from '../lib/url.mjs';
interface Props { p: any }
const { p } = Astro.props;
const href = u(`products/${p.category}/${p.slug}/`);
const first = p.colors[0];
---
<article class="su-card" data-card>
  <a class="su-card-img" href={href} aria-label={p.name} style="aspect-ratio:2/3">
    <Garment hex={first.hex} src={p.thumb} alt="" class="card-ph" />
  </a>
  <div class="su-dots" role="group" aria-label={`${p.name} 색상`}>
    {p.colors.map((c: any, i: number) => (
      <button type="button" class="su-dot" style={`--sw:${c.hex}`} aria-label={c.name} aria-pressed={i === 0 ? 'true' : 'false'}
        data-hex={c.hex} data-name={c.name} data-src={i === 0 ? u(p.thumb) : u(p.gallery[c.slug][0].src)}></button>
    ))}
  </div>
  <span class="card-color" data-card-color>{first.name}</span>
  <h3 class="su-card-name"><a href={href}>{p.name}</a></h3>
  <span class="su-card-price">{p.isPublic ? `${won(p.prices[0])}부터` : '견적 문의'}</span>
  {p.badge && <span class="badge">{p.badge}</span>}
</article>

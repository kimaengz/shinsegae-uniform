---
// 실제 이미지가 없을 때 쓰는 옷 실루엣 자리표시. src가 있으면 이미지를 보여준다.
import { u } from '../lib/url.mjs';
interface Props { hex: string; src?: string | null; ratio?: '23' | '43'; label?: string; alt?: string; class?: string }
const { hex, src, ratio = '23', label, alt = '', class: cls = '' } = Astro.props;
---
<span class={`ph ph-${ratio} ${cls}`} data-ph>
  {src ? <img src={u(src)} alt={alt} loading="lazy" /> : <span class="su-card-garment" style={`--sw:${hex}`} aria-hidden="true"></span>}
  {label && <span class="ph-label">{label}</span>}
</span>

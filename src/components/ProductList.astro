---
import ProductCard from './ProductCard.astro';
import { data } from '../lib/data.mjs';
import { u } from '../lib/url.mjs';
import { pdfPath } from '../lib/catalog.mjs';
interface Props { current: string }
const { current } = Astro.props;
const { categories, products } = data();
const cat = categories.find((c) => c.id === current);
// 배지(NEW 등)가 붙은 제품을 맨 앞에, 그 안에서는 order 순서
const list = (cat ? products.filter((p) => p.category === cat.id) : products).slice().sort((a, b) => Number(!a.badge) - Number(!b.badge));
---
<div class="wrap">
  <nav class="crumb su-caption" aria-label="현재 위치">
    <a href={u('')}>홈</a><span aria-hidden="true">/</span>
    {cat ? <><a href={u('products/')}>제품</a><span aria-hidden="true">/</span><span aria-current="page">{cat.name}</span></> : <span aria-current="page">제품</span>}
  </nav>
  <div class="page-h">
    <h1>{cat ? cat.name : '제품'}</h1>
    <p>{cat ? cat.summary : '6개 카테고리, 병원 로고 자수와 색상 맞춤이 가능합니다.'}</p>
    <a class="link-more pdf-link" href={u(pdfPath(cat ? `category-${cat.id}` : 'all'))} download={`신세계유니폼_${cat ? cat.name.replace(/ · /g, '_') : '전체'}_카탈로그.pdf`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>{cat ? '카탈로그 PDF' : '전체 카탈로그 PDF'}</a>
  </div>
  <nav class="tabs" aria-label="카테고리">
    <a href={u('products/')} aria-current={!cat ? 'page' : undefined}>전체<span class="tab-n num">{products.length}</span></a>
    {categories.map((c) => <a href={u(`products/${c.id}/`)} aria-current={cat?.id === c.id ? 'page' : undefined}>{c.name}<span class="tab-n num">{products.filter((p) => p.category === c.id).length}</span></a>)}
  </nav>
  <h2 class="su-sr">제품 목록</h2>
  <div class="cards">{list.map((p) => <ProductCard p={p} />)}</div>
</div>
<section class="cta-sec">
  <div class="wrap">
    <div class="cta">
      <div><h2>찾는 제품이 없나요?</h2><p>원하는 디자인이 있다면 일반 문의로 보내 주세요. 맞춤 제작을 상담해 드립니다.</p></div>
      <a class="su-btn su-btn-primary" href={u('quote/')}>견적문의</a>
    </div>
  </div>
</section>
